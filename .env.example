# Copiar a .env y completar. El .env esta gitignoreado.
#
# scripts/deploy.js lee este archivo y crea las credenciales en n8n. Los
# valores no viajan a los JSON de n8n/workflows/: se inyectan en memoria justo
# antes de subir.

# --- APIs del tracker ---
FOOTBALL_DATA_TOKEN=      # https://www.football-data.org/client/register
SERPAPI_KEY=              # https://serpapi.com/manage-api-key — 250 busquedas/mes
TRAVELPAYOUTS_TOKEN=      # https://www.travelpayouts.com/programs/
TELEGRAM_BOT_TOKEN=       # generado por @BotFather
TELEGRAM_CHAT_ID=         # obtenido con getUpdates
GOOGLE_SHEET_ID=          # de la URL del Sheet: docs.google.com/spreadsheets/d/<ID>/edit

# --- Instancia de n8n ---
N8N_BASE_URL=             # sin barra final
N8N_API_KEY=              # Settings -> n8n API -> Create an API key

# La credencial de Google Sheets usa OAuth2, asi que hay que crearla a mano en
# la UI de n8n (el consentimiento pasa por el navegador). Despues pegar aca su
# id, que se ve en la URL al abrirla: /home/credentials/<ID>
GOOGLE_SHEETS_CREDENTIAL_ID=
GOOGLE_SHEETS_CREDENTIAL_NAME=   # opcional, solo cosmetico en la UI
